# Set your real domain before deployment. The contact email is already configured.

NUXT_PUBLIC_SITE_URL=https://usepdfeasy.com
NUXT_PUBLIC_CONTACT_EMAIL=kakveyket408@gmail.com

# Optional: only after an authorized adult has obtained their own publisher ID.
# Supports AdSense verification by meta tag, WITHOUT displaying advertisements.
# Leave blank when not submitting the website for review.
NUXT_PUBLIC_ADSENSE_CLIENT_ID=

# NEVER enable during initial development or before site approval and consent setup.
# When enabled, the script MAY serve ads according to your AdSense account settings.
NUXT_PUBLIC_ENABLE_LIVE_ADS=false
